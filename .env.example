# Supabase (crie em https://supabase.com)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...sua_anon_key
SUPABASE_SERVICE_KEY=eyJ...sua_service_role_key

# VITE_ prefix: exigidos pelo Vite para o client-side (browser).
# SEM ELES O APP CRASHA EM BRANCO NO BROWSER.
# Copie os mesmos valores de SUPABASE_URL e SUPABASE_ANON_KEY acima.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...sua_anon_key

# SMTP (para envio de emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=suporte@seudominio.com
SMTP_PASSWORD=sua_senha_smtp

# URL do site (para tracking pixel)
SITE_URL=https://seu-dominio.com
